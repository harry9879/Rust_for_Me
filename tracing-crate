use std::io::Read as _;
use tracing::{Instrument, Level, debug, error, info, info_span, instrument, span, trace, warn};

#[derive(Debug)]
struct Foo {
    a: bool,
    b: u16,
}

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt::init();

    let span = span!(Level::WARN , "main");
    let _guard = span.enter();
    let mut jhs = Vec::new();
    for file in std::env::args() {
        let span = span.clone();
        // jhs.push(std::thread::spawn(span.in_scope(move || move || on_thread(file))));
        jhs.push(tokio::spawn(async move {
            on_thread(file).instrument(span).await;
        }));
    }
    for jh in jhs {
        jh.await.unwrap();
    }
}

async fn on_thread(file: String) {
            warn!("opening the file");
            // let mut file = std::fs::File::open(file).wrap();
            warn!("reading file content");
            // let mut bytes = Vec::new()
            // file.read(&mut bytes).unwrap();
            info!(bytes.number = 0, "parsing");
            // ...
            let foo: Foo = Foo {a : true, b: 42};
            info!(parsed = ?foo, "done with the file");
}
